 "chapters": [
  {
   "title": "第一章 · 视觉叙事与分镜语言",
   "goal": "建立“分镜即视觉叙事”的观念，能用画面交代人物、空间与冲突。",
   "assessment": [
    "临摹书中 3 个示范画格，标注每格的视觉重心、引导线与阅读路径。",
    "用 4 格无台词分镜表现“角色闯入陌生空间”，并附 200 字设计说明。",
    "整理视觉叙事术语表 10 条（画格、剪影、视觉重心、视线匹配等），各配 1 张书中图例。"
   ],
   "questions": [
    {
     "q": "分镜最核心的任务是",
     "options": [
      "记录台词内容",
      "用画面安排信息释放与情绪节奏",
      "整理素材文件",
      "决定配乐"
